OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# After adding approved teacher materials, set to true.
TEACHER_MATERIALS_APPROVED=false
# Server: only explicitly allowed website origins, comma-separated.
CHAT_ALLOWED_ORIGINS=https://gravitacia790.github.io
# Optional public backend endpoint for the GitHub Pages build (never put a key here).
NEXT_PUBLIC_CHAT_API_URL=

# Web search with domain filters; charged separately by OpenAI.
OPENAI_RESEARCH_MODEL=gpt-5-mini

# Server-side provider; OpenAI remains available by switching back.
AI_PROVIDER=openai
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=aliceai-llm/latest
YANDEX_RESEARCH_MODEL=aliceai-llm/latest
# Optional stable secret for source receipts across provider/key changes.
SOURCE_RECEIPT_SECRET=

# AI_PROVIDER=gigachat: only GigaChat, no external search or other provider keys.
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-3-Ultra
# If required, provide the official CA chain at process startup; keep TLS verification enabled.
# NODE_EXTRA_CA_CERTS=/absolute/path/to/trusted-ca.pem
